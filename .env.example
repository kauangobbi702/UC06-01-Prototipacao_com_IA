# Front-end: only public URL and anon/publishable key. Vite embeds VITE_* values
# into browser bundles; never place service_role or admin credentials here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional aliases accepted by vite.config.js if already used by the deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server/deployment only. Keep these out of client code and public repositories.
SUPABASE_PROJECT_REF=seu_project_ref
SUPABASE_ACCESS_TOKEN=seu_access_token_deploy
SUPABASE_DB_URL=postgresql://postgres:[SENHA]@db.[PROJECT_REF].supabase.co:5432/postgres?sslmode=require
SUPABASE_SERVICE_ROLE_KEY=service_role_apenas_no_servidor
